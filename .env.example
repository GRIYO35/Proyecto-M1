# Copiar este archivo a .env y completar. Nunca subir .env al repositorio.

# --- Credenciales (una por proveedor que se quiera usar) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Valores por defecto de la CLI (se pueden pisar con --proveedor / --respaldo / --prompt) ---
LLM_PROVEEDOR=anthropic
# Opcional: proveedor al que se deriva si el principal no responde (rate limit o caída).
# Dejar vacío para no usar fallback. Requiere la API key de ese proveedor.
LLM_PROVEEDOR_RESPALDO=
PROMPT_VERSION=v5_seguro

# --- Seguridad (opcional) ---
# El log de seguridad (data/seguridad.jsonl) NO guarda el texto del cliente: guarda
# un hash, una "huella" que identifica el texto sin poder leerlo. El salt es un
# texto secreto que se mezcla antes de calcular el hash, para que nadie pueda
# adivinar qué escribió un cliente probando textos y comparando huellas.
#
#   sin salt:  hash("Ignorá tus instrucciones")         -> siempre el mismo, cualquiera lo calcula
#   con salt:  hash(LOG_SALT + "Ignorá tus instrucciones") -> sólo lo calcula quien conoce LOG_SALT
#
# Poné cualquier texto largo y al azar, y no lo cambies después. Para generar uno:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Si lo dejás vacío, se usa un valor por defecto (sirve para probar, no para producción).
LOG_SALT=
