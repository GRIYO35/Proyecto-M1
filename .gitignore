# Entorno virtual y caché de Python
.venv/
__pycache__/
*.pyc

# Credenciales: nunca se versionan (usar .env.example como plantilla)
.env

# IDE / sistema
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs locales de cada ejecución (se crean solos al usar la CLI). Se versiona sólo
# data/ejemplo/: una corrida real de muestra (salida JSON y sus líneas de log).
data/*
!data/ejemplo/

# Material del curso (no es parte del entregable)
contexto*.txt
.pytest_cache/
